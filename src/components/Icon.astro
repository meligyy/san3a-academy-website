const body = isFilled ? FILLED[name] : (P[name] || P.spark);
const aria = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
{diamond ? (
  <svg class={`dicon ${cls}`} style={style} viewBox="0 0 48 48" {...aria}>
    <rect x="10" y="10" width="28" height="28" rx="2" transform="rotate(45 24 24)" fill="none" stroke="currentColor" stroke-width="2.2" />
    <g transform="translate(15 15) scale(.75)" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={body} />
  </svg>
) : isFilled ? (
  <svg class={cls} style={style} width="1.15em" height="1.15em" viewBox="0 0 24 24" fill="currentColor" {...aria} set:html={body} />
) : (
  <svg class={cls} style={style} width="1.15em" height="1.15em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" {...aria} set:html={body} />
)}
