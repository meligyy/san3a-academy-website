---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Shapes from '../components/Shapes.astro';
import LiveStrip from '../components/LiveStrip.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Faq from '../components/Faq.astro';
import Lockup from '../components/Lockup.astro';
import { url, lp } from '../lib/url.js';
import { s } from '../i18n/ui.js';
import { site } from '../data/site.js';
import { programs, stories } from '../lib/content.js';

interface Props { lang: 'en' | 'ar'; program: any }
const { lang, program: p } = Astro.props;
const L = s(lang);
const c = p[lang] || p.en;
const formId = p.tally ? (site.tally[p.tally.form] || p.tally.form) : null;
const interestHref = `mailto:${site.email}?subject=${encodeURIComponent((lang === 'ar' ? 'تسجيل اهتمام: ' : 'Register interest: ') + (p[lang] || p.en).title)}`;
const path = `/programs/${p.slug}/`;
const related = programs.filter((x) => x.slug !== p.slug && (x.audience === p.audience || (p.related || []).includes(x.slug))).slice(0, 3);
const has = (a) => Array.isArray(a) && a.length > 0;
const progStories = stories.filter((x) => x.program === p.slug && x.quote && (!c.testimonial || (x.name?.en !== c.testimonial.name && x.name?.ar !== c.testimonial.name))).slice(0, 3);
const tabs = [
  ['overview', L.overview, true],
  ['syllabus', L.syllabus, has(c.modules)],
  ['projects', L.projects, has(c.projects)],
  ['who', L.who_for, has(c.whoFor)],
  ['fees', L.fees_title, !!(c.price || c.fees)],
  ['faq', L.faq, has(c.faq)],
  ['apply', L.apply, !!formId],
].filter((x) => x[2]);
const facts = [
  ['clock', L.duration, c.duration],
  ['laptop', L.format, c.formatLabel || (p.format ? L[`format_${p.format}`] : '')],
  ['level', p.audience === 'kids' ? L.age : L.level, c.level],
  ['calendar', L.next_start, c.nextStart],
  ['pin', L.location, c.location],
  ['money', L.fees, c.price],
].filter((f) => f[2]);
const statusKey = `status_${p.status || 'open'}`;
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent((lang === 'ar' ? 'مرحبًا، عايز أعرف أكتر عن ' : 'Hi! I would like to know more about ') + c.title)}` : null;
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: c.title,
  description: c.summary || c.short,
  inLanguage: lang === 'ar' ? 'ar' : 'en',
  provider: { '@type': 'EducationalOrganization', name: 'San3a Academy', sameAs: 'https://san3aacademy.com' },
  ...(c.duration ? { timeRequired: c.duration } : {}),
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: p.format === 'online' ? 'online' : p.format === 'hybrid' ? 'blended' : 'onsite',
    location: c.location || 'Cairo, Egypt',
    ...(p.nextRound && p.nextRound.start ? { startDate: p.nextRound.start } : {}),
  },
};
---
<Base lang={lang} title={c.seoTitle || c.title} description={c.seoDescription || c.short} path={path} image={p.image} audience={p.audience} schema={courseSchema} program={p.slug}>
  <section class="ph" data-audience={p.audience}>
    <div class="ph-bg"><img src={url(p.image || '/images/photos/instructor-demo.jpg')} alt="" fetchpriority="high" /></div>
    <div class="container">
      <div class="ph-grid">
        <div>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href={lp(lang, '/')}>{L.home}</a><span aria-hidden="true">/</span>
            <a href={lp(lang, '/programs/')}>{L.nav_programs}</a><span aria-hidden="true">/</span>
            <a href={lp(lang, `/${p.audience}/`)}>{L[`audience_${p.audience}`]}</a>
          </nav>
          <div class="badges">
            <span class="badge badge--audience">{L[`audience_${p.audience}`]}</span>
            <span class="badge">{L[`type_${p.type}`] || p.type}</span>
            <span class="badge">{L[statusKey] || L.status_open}</span>
            {p.funded && <span class="badge">{lang === 'ar' ? 'منحة ممولة' : 'Funded scholarship'}</span>}
          </div>
          <h1>{c.title}</h1>
          {c.tagline && <p class="tagline">{c.tagline}</p>}
          {c.summary && <p class="summary">{c.summary}</p>}
          <div class="ph-cta">
            {formId && <a class="btn btn-primary btn-lg" href="#apply" data-track="apply_click">{c.ctaLabel || L.apply_now} <Icon name="arrow" class="arrow" /></a>}
            {wa && <a class="btn btn-outline btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" style="width:20px;height:20px" />{L.talk_whatsapp}</a>}
            {!formId && <a class="btn btn-primary btn-lg" href={interestHref} data-track="interest_click">{c.applyTitle || (lang === 'ar' ? 'سجّل اهتمامك' : 'Register your interest')} <Icon name="arrow" class="arrow" /></a>}
            {!wa && formId && c.modules && <a class="btn btn-outline btn-lg" href="#syllabus">{L.syllabus}</a>}
          </div>
          {p.commercial && <LiveStrip slug={p.liveKey || p.slug} lang={lang} dark nextRound={p.nextRound} />}
        </div>
        <aside class="facts-card" aria-label={lang === 'ar' ? 'معلومات سريعة' : 'Key facts'}>
          <ul class="info-list">
            {facts.map(([ic, k, v]) => (
              <li class="info-item"><Icon name={ic} diamond /><div><b>{k}</b><span>{v}</span></div></li>
            ))}
          </ul>
          {c.priceNote && <p class="muted mt-2 mb-0" style="font-size:.92rem">{c.priceNote}</p>}
          <div class="mt-3"><Lockup audience={p.audience} /></div>
        </aside>
      </div>
    </div>
    <div class="stripe-edge" aria-hidden="true"></div>
  </section>
  <div data-hero-end></div>

  <nav class="subnav" data-subnav aria-label={lang === 'ar' ? 'أقسام البرنامج' : 'Program sections'}>
    <div class="container">
      {tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      {formId && <a class="btn btn-primary btn-sm" href="#apply" style="border-bottom:0;color:#fff">{L.apply_now}</a>}
    </div>
  </nav>

  <section id="overview" class="section">
    <div class="container split" style="align-items:start">
      <div>
        <span class="eyebrow"><span class="diamond"></span>{L.overview}</span>
        <h2 class="h-lg">{c.overviewTitle || L.what_youll_learn}</h2>
        {c.overview && <div class="prose" set:html={c.overview} />}
        {has(c.learn) && (
          <ul class="learn-list mt-3">{c.learn.map((x) => <li>{x}</li>)}</ul>
        )}
      </div>
      <div>
        {has(c.skills) && (
          <div class="card card-pad">
            <h3 class="h-sm">{L.skills}</h3>
            <div class="flex wrap gap-1 mt-2">{c.skills.map((k) => <span class="chip">{k}</span>)}</div>
          </div>
        )}
        {has(c.outcomes) && (
          <div class="grid grid-2 mt-3">
            {c.outcomes.map((o) => (
              <div class="card card-pad">
                <div class="price ltr" style="color:var(--red)">{o.n}</div>
                <p class="mb-0 muted">{o.label}</p>
              </div>
            ))}
          </div>
        )}
        {c.outcomesSource && <p class="muted mt-1" style="font-size:.85rem">{c.outcomesSource}</p>}
      </div>
    </div>
  </section>

  {has(c.modules) && (
    <section id="syllabus" class="section section--alt">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{L.syllabus}</span>
          <h2 class="h-xl">{c.syllabusTitle || (lang === 'ar' ? `${c.modules.length} وحدات من الفكرة للنموذج` : `${c.modules.length} modules, idea to working prototype`)}</h2>
          {c.syllabusLead && <p class="lead">{c.syllabusLead}</p>}
        </div></div>
        <div class="modules">
          {c.modules.map((m, i) => (
            <details class="module" open={i === 0}>
              <summary>
                <span class="num ltr">{String(m.n ?? i).padStart(2, '0')}</span>
                <span class="mt">{m.title}{m.meta && <small>{m.meta}</small>}</span>
                <Icon name="chevron" class="chev" />
              </summary>
              <div class="mb">
                {m.summary && <p class="mb-0">{m.summary}</p>}
                {has(m.topics) && <ul>{m.topics.map((x) => <li>{x}</li>)}</ul>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {has(c.projects) && (
    <section id="projects" class="section">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{L.projects}</span>
          <h2 class="h-xl">{c.projectsTitle || L.projects_title}</h2>
        </div></div>
        <div class="grid grid-3">
          {c.projects.map((pr, i) => (
            <div class="proj">
              <span class="k ltr">{lang === 'ar' ? 'مشروع' : 'PROJECT'} {String(i + 1).padStart(2, '0')}</span>
              <h3>{pr.title}</h3>
              <p>{pr.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {(has(c.whoFor) || has(c.requirements)) && (
    <section id="who" class="section section--alt">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{L.who_for}</span>
          <h2 class="h-xl">{c.whoTitle || L.who_for}</h2>
        </div></div>
        <div class="who">
          {has(c.whoFor) && <div class="who-box"><h3 class="h-sm">{L.who_for}</h3><ul>{c.whoFor.map((x) => <li>{x}</li>)}</ul></div>}
          {has(c.requirements) && <div class="who-box"><h3 class="h-sm">{L.requirements}</h3><ul>{c.requirements.map((x) => <li>{x}</li>)}</ul></div>}
        </div>
      </div>
    </section>
  )}

  {c.testimonial && c.testimonial.quote && (
    <section class="section section--tight">
      <div class="container" style="max-width:960px">
        <figure class="quote">
          <span class="bar-mark" aria-hidden="true"></span>
          <blockquote>“{c.testimonial.quote}”</blockquote>
          <figcaption class="who-q"><span class="diamond" style="color:var(--red)"></span><div><b>{c.testimonial.name}</b><small>{c.testimonial.role}</small></div></figcaption>
        </figure>
      </div>
    </section>
  )}

  {progStories.length > 0 && (
    <section class="section section--night">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{L.nav_stories}</span>
          <h2 class="h-xl">{lang === 'ar' ? 'بكلام خريجينا' : 'In our graduates’ words'}</h2>
        </div>
          <a class="btn btn-outline" href={lp(lang, '/stories/')}>{L.all_stories} <Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="grid grid-3">
          {progStories.map((x) => (
            <figure style="margin:0;border-top:3px solid var(--red);padding-top:18px">
              <blockquote style="margin:0 0 14px;font-family:var(--f-sub);font-weight:700;font-size:1.08rem;color:#fff;line-height:1.45">“{x.quote[lang] || x.quote.en}”</blockquote>
              <figcaption style="color:#D9C6CB;font-size:.95rem"><b style="color:#fff">{x.name[lang] || x.name.en}</b><br />{x.role[lang] || x.role.en}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {(c.price || c.fees) && (
    <section id="fees" class="section">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{L.fees_title}</span>
          <h2 class="h-xl">{c.fees?.title || L.fees_title}</h2>
        </div></div>
        <div class="fees">
          <div class="card card-pad">
            {c.price && <div class="price">{c.price}</div>}
            {c.priceNote && <p class="muted">{c.priceNote}</p>}
            {c.fees?.body && <p>{c.fees.body}</p>}
            {formId && <a class="btn btn-primary mt-2" href="#apply">{c.ctaLabel || L.apply_now}</a>}
          </div>
          {has(c.fees?.items) && (
            <div class="card card-pad">
              <ul class="info-list">
                {c.fees.items.map((x) => <li class="info-item"><Icon name="check" style="width:22px;height:22px;color:var(--red);flex:none" /><span>{x}</span></li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {has(c.faq) && (
    <section id="faq" class="section section--alt">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{L.faq}</span>
          <h2 class="h-xl">{L.faq_title}</h2>
        </div></div>
        <Faq items={c.faq} />
      </div>
    </section>
  )}

  {formId && (
    <section id="apply" class="section">
      <div class="container apply-wrap">
        <div>
          <span class="eyebrow"><span class="diamond"></span>{L.apply}</span>
          <h2 class="h-xl">{c.applyTitle || L.apply_title}</h2>
          <p class="lead">{c.applyLead || L.apply_lead}</p>
          {p.commercial && <div class="mt-3"><LiveStrip slug={p.liveKey || p.slug} lang={lang} nextRound={p.nextRound} compact /></div>}
          {has(c.applySteps) && (
            <ol class="steps mt-4" style="grid-template-columns:1fr;list-style:none;padding:0">
              {c.applySteps.map((st, i) => (
                <li class="step" style="display:flex;gap:16px;align-items:flex-start;padding:16px">
                  <span class="k" style="margin:0;flex:none;width:32px;height:32px"><span class="ltr">{i + 1}</span></span>
                  <div><h3 style="margin:0 0 2px">{st.title}</h3><p>{st.body}</p></div>
                </li>
              ))}
            </ol>
          )}
          <Shapes variant="cluster" style="font-size:26px;color:var(--red);margin-top:28px" />
        </div>
        <TallyEmbed formId={formId} lang={lang} product={p.tally?.product} title={`${L.apply} — ${c.title}`} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head"><div><h2 class="h-lg">{L.related}</h2></div>
          <a class="link-arrow" href={lp(lang, '/programs/')}>{L.view_all_programs} <Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="grid grid-3">{related.map((r) => <div><ProgramCard program={r} lang={lang} /></div>)}</div>
      </div>
    </section>
  )}

  {formId && (
    <div class="mobile-apply" data-mobile-apply>
      <span class="m-title">{c.title}</span>
      <a class="btn btn-primary" href="#apply" data-track="apply_click">{c.ctaLabel || L.apply_now}</a>
    </div>
  )}
</Base>
