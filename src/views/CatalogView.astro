---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import LiveTicker from '../components/LiveTicker.astro';
import CtaBand from '../components/CtaBand.astro';
import { lp, url } from '../lib/url.js';
import { s } from '../i18n/ui.js';
import { programs } from '../lib/content.js';

interface Props { lang: 'en' | 'ar' }
const { lang } = Astro.props;
const L = s(lang);
const uniq = (a) => [...new Set(a.filter(Boolean))];
const types = uniq(programs.map((p) => p.type));
const formats = uniq(programs.map((p) => p.format));
const groups = [
  { key: 'audience', label: L.filter_audience, values: ['kids', 'youth', 'educators'], text: (v) => L[`audience_${v}`] },
  { key: 'type', label: L.filter_type, values: types, text: (v) => L[`type_${v}`] || v },
  { key: 'format', label: L.filter_format, values: formats, text: (v) => L[`format_${v}`] || v },
  { key: 'cost', label: lang === 'ar' ? 'التكلفة' : 'Cost', values: ['paid', 'funded'], text: (v) => v === 'funded' ? (lang === 'ar' ? 'ممول بالكامل' : 'Fully funded') : (lang === 'ar' ? 'بمصاريف' : 'Paid') },
];
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: programs.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: (p[lang] || p.en).title, url: lp(lang, `/programs/${p.slug}/`) })),
};
---
<Base lang={lang} title={L.catalog_title} description={L.catalog_lead} path="/programs/" image="/images/photos/showcase-day.jpg" schema={itemList}>
  <section class="page-hero" style={`--hero-img:url(${url('/images/photos/showcase-day.jpg')})`}>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href={lp(lang, '/')}>{L.home}</a><span aria-hidden="true">/</span><span>{L.nav_programs}</span></nav>
      <h1 class="display" style="max-width:16ch">{L.catalog_title}</h1>
      <p class="lead">{L.catalog_lead}</p>
      <div class="mt-3"><LiveTicker lang={lang} dark /></div>
    </div>
    <div class="stripe-edge" aria-hidden="true"></div>
  </section>

  <section class="section section--alt" style="padding-top:40px">
    <div class="container">
      <div class="filters" role="search">
        {groups.map((g) => (
          <div class="filter-group">
            <span id={`f-${g.key}`}>{g.label}</span>
            <div class="seg" role="group" aria-labelledby={`f-${g.key}`}>
              <button type="button" data-filter={g.key} data-value="all" aria-pressed="true">{L.filter_all}</button>
              {g.values.map((v) => <button type="button" data-filter={g.key} data-value={v} aria-pressed="false">{g.text(v)}</button>)}
            </div>
          </div>
        ))}
        <label class="search">
          <span class="sr-only">{L.search_placeholder}</span>
          <Icon name="search" />
          <input type="search" placeholder={L.search_placeholder} data-search autocomplete="off" />
        </label>
      </div>
      <p class="results-meta" aria-live="polite"><b data-count>{programs.length}</b> {L.results}</p>
      <div class="grid grid-3" data-catalog>
        {programs.map((p) => <div><ProgramCard program={p} lang={lang} /></div>)}
      </div>
      <div class="empty mt-3" data-empty hidden>
        <p>{L.no_results}</p>
        <button class="btn btn-outline btn-sm" type="button" data-clear>{L.clear_filters}</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand title={lang === 'ar' ? 'بتدوّر على برنامج لمؤسستك أو مدرستك؟' : 'Need a program for your school or organisation?'}
        text={lang === 'ar' ? 'بنصمم برامج ومعامل ومناهج مخصوصة للمدارس والجامعات والشركات والمنظمات.' : 'We design custom programs, makerspaces and curricula for schools, universities, companies and NGOs.'}>
        <a class="btn btn-white btn-lg" href={lp(lang, '/partners/')}>{L.nav_partners} <Icon name="arrow" class="arrow" /></a>
      </CtaBand>
    </div>
  </section>
</Base>
