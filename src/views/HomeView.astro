---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Shapes from '../components/Shapes.astro';
import ProgramCard from '../components/ProgramCard.astro';
import LiveTicker from '../components/LiveTicker.astro';
import StatsBand from '../components/StatsBand.astro';
import CtaBand from '../components/CtaBand.astro';
import PostCard from '../components/PostCard.astro';
import { url, lp, t } from '../lib/url.js';
import { s } from '../i18n/ui.js';
import { featuredPrograms, programsFor, posts, news } from '../lib/content.js';
import home from '../content/pages/home.json';
import partners from '../content/pages/partners.json';

interface Props { lang: 'en' | 'ar' }
const { lang } = Astro.props;
const L = s(lang);
const H = home;
const featured = featuredPrograms().slice(0, 6);
const latestPosts = posts(lang).slice(0, 3);
const latestNews = news.slice(0, 3);
const audLabel = { kids: ['أطفال', 'KIDS'], youth: ['شباب', 'YOUTH'], educators: ['مدرسين', 'EDUCATORS'] };
const logoPartners = (partners.list || []).filter((p) => p.home !== false).slice(0, 12);
---
<Base lang={lang} title={lang === 'ar' ? 'صنعة أكاديمي — اتعلّم بإيدك' : 'San3a Academy — Learn by making'} description={t(H.hero.lead, lang)} path="/" image={H.hero.image}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow"><span class="diamond"></span>{t(H.hero.eyebrow, lang)}</span>
        <h1 class="display">{t(H.hero.titleA, lang)} <span class="red">{t(H.hero.titleB, lang)}</span></h1>
        <p class="lead">{t(H.hero.lead, lang)}</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href={lp(lang, '/programs/')}>{t(H.hero.ctaPrimary, lang)} <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn-outline btn-lg" href={lp(lang, '/programs/maker-diploma/')}>{t(H.hero.ctaSecondary, lang)}</a>
        </div>
        <div class="mt-3"><LiveTicker lang={lang} /></div>
      </div>
      <div class="hero-media">
        <img class="photo" src={url(H.hero.image)} alt={t(H.hero.imageAlt, lang)} width="800" height="880" fetchpriority="high" />
        <Shapes variant="cluster" />
        <div class="title-box">
          <p class="t">{t(H.hero.boxTitle, lang)}</p>
          <p class="s">{t(H.hero.boxLine, lang)}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><div>
        <span class="eyebrow"><span class="diamond"></span>{t(H.paths.eyebrow, lang)}</span>
        <h2 class="h-xl">{t(H.paths.title, lang)}</h2>
        <p class="lead">{t(H.paths.lead, lang)}</p>
      </div></div>
      <div class="grid grid-3">
        {H.paths.items.map((a) => (
          <a class="acard reveal" href={lp(lang, `/${a.key}/`)} data-audience={a.key}>
            <div class="acard-media"><img src={url(a.image)} alt="" loading="lazy" width="800" height="500" /></div>
            <div class="acard-bar"></div>
            <div class="acard-body">
              <div class="acard-label"><span class="ar" lang="ar">{audLabel[a.key][0]}</span><span class="en" lang="en">{audLabel[a.key][1]}</span></div>
              <p class="mb-0">{a[lang]}</p>
              <p class="progs">{programsFor(a.key).map((p) => (p[lang] || p.en).title).join(' · ')}</p>
              <span class="link-arrow">{L.learn_more} <Icon name="arrow" class="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow"><span class="diamond"></span>{t(H.featured.eyebrow, lang)}</span>
          <h2 class="h-xl">{t(H.featured.title, lang)}</h2>
        </div>
        <a class="btn btn-outline" href={lp(lang, '/programs/')}>{L.view_all_programs} <Icon name="arrow" class="arrow" /></a>
      </div>
      <div class="grid grid-3">
        {featured.map((p) => <div class="reveal"><ProgramCard program={p} lang={lang} /></div>)}
      </div>
    </div>
  </section>

  <StatsBand lang={lang} />

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow"><span class="diamond"></span>{t(H.how.eyebrow, lang)}</span>
        <h2 class="h-xl">{t(H.how.title, lang)}</h2>
        <p class="lead">{t(H.how.lead, lang)}</p>
        <div class="grid grid-2 mt-3">
          {H.how.items.map((i) => (
            <div class="reveal">
              <span class="ltr" style="font-family:Montserrat,var(--f-display);font-weight:800;color:var(--red)">{i.k}</span>
              <h3 class="h-sm mt-1" style="margin-bottom:4px">{lang === 'ar' ? i.ar : i.en}</h3>
              <p class="muted mb-0" style="font-size:.96rem">{lang === 'ar' ? i.dar : i.den}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="mosaic" aria-hidden="true">
        <img class="a" src={url('/images/photos/instructor-demo.jpg')} alt="" loading="lazy" />
        <img src={url('/images/photos/kid-coding-piano.jpg')} alt="" loading="lazy" />
        <img src={url('/images/photos/output-greenhouse.jpg')} alt="" loading="lazy" />
        <img src={url('/images/photos/learner-presenting.jpg')} alt="" loading="lazy" />
        <img src={url('/images/photos/output-smart-city.jpg')} alt="" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section--night">
    <div class="container">
      <div class="section-head"><div>
        <span class="eyebrow"><span class="diamond"></span>{t(H.proof.eyebrow, lang)}</span>
        <h2 class="h-xl">{t(H.proof.title, lang)}</h2>
      </div>
        <a class="btn btn-outline" href={lp(lang, '/stories/')}>{L.all_stories} <Icon name="arrow" class="arrow" /></a>
      </div>
      <div class="grid grid-4">
        {H.proof.stats.map((st) => (
          <div style="border-top:3px solid var(--red);padding-top:16px">
            <div class="ltr" style="font-family:Montserrat,var(--f-display);font-weight:800;font-size:clamp(2.4rem,4vw,3.2rem);color:#fff;line-height:1">{st.n}</div>
            <p class="mt-1" style="color:#E7D5DA">{st[lang]}</p>
          </div>
        ))}
      </div>
      <p class="mt-2" style="font-size:.85rem;color:#BFA9AF">{t(H.proof.source, lang)}</p>
    </div>
  </section>

  {logoPartners.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <div class="section-head"><div>
          <span class="eyebrow"><span class="diamond"></span>{t(H.partners.eyebrow, lang)}</span>
          <h2 class="h-lg">{t(H.partners.title, lang)}</h2>
        </div></div>
        <div class="logo-wall">
          {logoPartners.map((p) => <span class="partner">{p.name}<small>{t(p.role, lang)}</small></span>)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container">
      <CtaBand title={t(H.business.title, lang)} text={t(H.business.text, lang)}>
        <a class="btn btn-white btn-lg" href={lp(lang, '/partners/')}>{t(H.business.cta, lang)} <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn-outline btn-lg" style="color:#fff" href={lp(lang, '/contact/')}>{L.contact_us}</a>
      </CtaBand>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head">
          <div><span class="eyebrow"><span class="diamond"></span>{L.nav_blog}</span><h2 class="h-xl">{L.blog_latest}</h2></div>
          <a class="btn btn-outline" href={lp(lang, '/blog/')}>{L.nav_blog} <Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="grid grid-3">{latestPosts.map((p) => <div class="reveal"><PostCard post={p} lang={lang} /></div>)}</div>
      </div>
    </section>
  )}

  {latestNews.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div><span class="eyebrow"><span class="diamond"></span>{L.nav_news}</span><h2 class="h-lg">{lang === 'ar' ? 'آخر الأخبار والفعاليات' : 'Latest news & events'}</h2></div>
          <a class="link-arrow" href={lp(lang, '/news/')}>{L.all_news} <Icon name="arrow" class="arrow" /></a>
        </div>
        <div class="grid grid-3">
          {latestNews.map((n) => (
            <a class="ncard" href={lp(lang, `/news/${n.slug}/`)}>
              <img src={url(n.image || '/images/photos/cohort-group.jpg')} alt="" loading="lazy" width="640" height="360" />
              <div class="nb">
                <time datetime={n.date}>{new Date(n.date).toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
                <h3>{t(n.title, lang)}</h3>
                <p>{t(n.summary, lang)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
